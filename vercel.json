        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-n3aovDzTXw8IDzKLB3RwB/PhI8L/mN1Kb4LHf2QaX7o=' 'sha256-eq/ohLBFwS3580Abx+e45Pcmnu233C4F7nhDQYDReAE='; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
