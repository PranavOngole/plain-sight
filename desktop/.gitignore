src-tauri/gen/
src-tauri/permissions/autogenerated/
# The App Store build's configuration (npm run appstore:config): it holds a
# path on this Mac and the team's identifiers, so it is never committed.
src-tauri/tauri.appstore.conf.json
src-tauri/Entitlements.appstore.plist
# What a failed or killed run of that command can leave beside it holds the
# same: <name>.earlier-<pid> and <name>.tmp-<pid> (DM-258, QA-G-47).
src-tauri/tauri.appstore.conf.json.*
src-tauri/Entitlements.appstore.plist.*
